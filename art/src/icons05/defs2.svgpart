<pattern id="knit" width="10" height="9" patternUnits="userSpaceOnUse"><rect width="10" height="9" fill="currentColor"/><path d="M0 0 L5 7 L10 0" stroke="#000" stroke-opacity=".28" stroke-width="1.6" fill="none"/><path d="M0 2 L5 9 L10 2" stroke="#fff" stroke-opacity=".12" stroke-width="1" fill="none"/></pattern>
