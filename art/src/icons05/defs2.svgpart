<defs>
<filter id="tex" x="-5%" y="-5%" width="110%" height="110%"><feTurbulence type="fractalNoise" baseFrequency=".9" numOctaves="3" seed="2" result="t"/><feColorMatrix in="t" type="saturate" values="0" result="g"/><feComponentTransfer in="g" result="g2"><feFuncR type="linear" slope=".9" intercept=".38"/><feFuncG type="linear" slope=".9" intercept=".38"/><feFuncB type="linear" slope=".9" intercept=".38"/></feComponentTransfer><feBlend in="SourceGraphic" in2="g2" mode="multiply" result="b"/><feComposite in="b" in2="SourceGraphic" operator="in"/></filter>
<filter id="rust" x="-5%" y="-5%" width="110%" height="110%"><feTurbulence type="fractalNoise" baseFrequency=".09" numOctaves="5" seed="7" result="t"/><feColorMatrix in="t" type="matrix" values="0 0 0 0 .52  0 0 0 0 .26  0 0 0 0 .1  0 0 0 -9 3.7" result="r"/><feTurbulence type="fractalNoise" baseFrequency=".5" numOctaves="2" seed="9" result="t3"/><feColorMatrix in="t3" type="matrix" values="0 0 0 0 .35  0 0 0 0 .16  0 0 0 0 .06  0 0 0 -6 2.6" result="r2"/><feMerge result="rr"><feMergeNode in="r"/><feMergeNode in="r2"/></feMerge><feComposite in="rr" in2="SourceGraphic" operator="in" result="ri"/><feMerge result="m"><feMergeNode in="SourceGraphic"/><feMergeNode in="ri"/></feMerge><feTurbulence type="fractalNoise" baseFrequency=".9" numOctaves="2" seed="4" result="t2"/><feColorMatrix in="t2" type="saturate" values="0" result="g"/><feComponentTransfer in="g" result="g2"><feFuncR type="linear" slope=".9" intercept=".4"/><feFuncG type="linear" slope=".9" intercept=".4"/><feFuncB type="linear" slope=".9" intercept=".4"/></feComponentTransfer><feBlend in="m" in2="g2" mode="multiply" result="b"/><feComposite in="b" in2="SourceGraphic" operator="in"/></filter>
<filter id="blur4" x="-20%" y="-50%" width="140%" height="200%"><feGaussianBlur stdDeviation="5"/></filter>
<filter id="glow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="8"/></filter>
<filter id="soft"><feGaussianBlur stdDeviation="1.2"/></filter>
<linearGradient id="sh" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".28"/><stop offset=".45" stop-color="#fff" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity=".45"/></linearGradient>
<linearGradient id="cyl" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#000" stop-opacity=".35"/><stop offset=".3" stop-color="#fff" stop-opacity=".25"/><stop offset=".55" stop-color="#fff" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity=".5"/></linearGradient>
