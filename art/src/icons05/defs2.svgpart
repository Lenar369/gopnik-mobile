<pattern id="plaidR" width="26" height="26" patternUnits="userSpaceOnUse" patternTransform="rotate(-8)"><rect width="26" height="26" fill="#8c3a2e"/><rect y="9" width="26" height="8" fill="#4e2019" opacity=".75"/><rect x="9" width="8" height="26" fill="#4e2019" opacity=".75"/><rect y="21" width="26" height="2" fill="#d9c89c" opacity=".7"/><rect x="21" width="2" height="26" fill="#d9c89c" opacity=".7"/></pattern>
